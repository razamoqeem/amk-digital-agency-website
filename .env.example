# KivoReach Website — example configuration.
# Copy this file to ".env" and fill in real values. Never commit ".env".
# The static pages need no secrets. These values are used when pages are generated
# and by the tools service (Website/api/).

# --- Addresses (domain not confirmed yet). Never hard-code a *.vercel.app address. ---
SITE_URL=[TO BE CONFIRMED]
APP_URL=[TO BE CONFIRMED]
# Leave API_URL empty when the tools service also serves the pages (local testing).
API_URL=

# --- Tools service (Website/api/) ---
# Free runs per tool: without email, and in total after the email is confirmed.
TOOLS_ANON_RUNS=3
TOOLS_TOTAL_RUNS=10
# Runs per tool, per day, from one network address.
TOOLS_IP_DAILY_RUNS=30
TOOLS_RATE_PER_MINUTE=20
TOOLS_CACHE_HOURS=24
# Self-chosen daily ceilings. The tools pause at 80% of these.
TOOLS_CRAWL_DAILY_LIMIT=500
TOOLS_REGISTRY_DAILY_LIMIT=500
# Signing key for the visitor cookie. Empty = a random key is created in api/data/.
TOOLS_SECRET=
# Bot check (Cloudflare Turnstile). Empty = switched off.
TURNSTILE_SECRET=
# Only needed when the pages are served from a different address than the tools service.
ALLOWED_ORIGINS=

# Domain rank tool (optional). Free key from the Open PageRank service. The free key works
# from one network address only. Leave empty to keep the tool switched off.
OPEN_PAGERANK_KEY=
TOOLS_RANK_DAILY_LIMIT=500

# Tester email addresses, separated by commas. A tester confirms the email once on the tools page;
# after that the tester limits in content/limits.json apply (unlimited by default). Never commit real addresses.
TESTER_EMAILS=

# --- Added 2026-11-15: Vercel functions, bot check, chat and request form ---
# Names only. Put real values in the host's environment screen (Vercel), never in a committed file.
# Bot check secret key is TURNSTILE_SECRET above; the public SITE key goes in js/config.js.
# Required in production: TOOLS_SECRET (24+ characters) and TURNSTILE_SECRET. Without them the site refuses runs.
REQUIRE_BOT_CHECK=
# Redis store for daily limits (Upstash, or Vercel's store: KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Chat assistant: free-tier keys ONLY. The website never reads OPENAI_API_KEY, ANTHROPIC_API_KEY or XAI_API_KEY.
GEMINI_SEO_API_KEY=
OPENROUTER_API_KEY=
CHAT_DAILY_LIMIT=6
CHAT_IP_DAILY_LIMIT=20
CHAT_GLOBAL_DAILY_LIMIT=1000
CHAT_MODEL_FAST=
CHAT_MODEL_STRATEGIST=
CHAT_MODEL_AUTO=
CHAT_MODEL_FALLBACK=
# Where "request a free audit / App invite" goes (an https webhook address), or leave empty to use the Redis store.
LEAD_WEBHOOK_URL=
# Optional 24+ character secret: signs each webhook delivery (X-AMK-Signature) so the receiver can verify it.
LEAD_WEBHOOK_SECRET=
# Tool allowances per visitor.
TOOLS_DAILY_LIMIT=10
TOOLS_MONTHLY_LIMIT=100
# Owner-only deployment check at /api/health: set 24+ random characters to switch it on, leave empty to keep it off.
HEALTH_TOKEN=
